{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "n": {"type": "integer"},
    "type": {"enum": ["DEFECT", "REQUEST", "QUESTION", "DOCS", "UNCLASSIFIED"]},
    "finding": {"type": "string", "minLength": 1},
    "size": {"enum": ["EASY", "MEDIUM", "HARD"]},
    "phase": {"enum": ["SINGLE-PHASE", "WORKFLOW"]},
    "problem": {"type": "string"},
    "cause": {"type": "string"},
    "propose": {"type": "string"},
    "verify": {"type": "string"},
    "decision": {"type": ["string", "null"]}
  },
  "required": ["n", "type", "finding", "size", "phase", "problem", "cause", "propose", "verify", "decision"]
}
