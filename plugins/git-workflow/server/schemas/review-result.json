{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["done", "failed"]},
    "report": {"type": "string", "minLength": 1},
    "provider_changed": {"type": "boolean"},
    "done": {"type": "array", "items": {"type": "integer"}},
    "refused": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"n": {"type": "integer"}, "why": {"type": "string", "minLength": 1}},
        "required": ["n", "why"]
      }
    }
  },
  "required": ["status", "report", "provider_changed", "done", "refused"]
}
