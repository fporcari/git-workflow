#!/bin/sh
# gw — the git-workflow CLI. Lives beside the plugin's Python so the desk and
# the skills share one provider layer; link it into PATH, do not copy it.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
exec python3 "$(cd "$(dirname "$self")" && pwd -P)/../server/gw.py" "$@"
